<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="edu.hitsz.LeaderboardForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="501" height="539"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f8fae" binding="topPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d9865" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="20" style="1"/>
              <foreground color="-1761737"/>
              <text value="排行榜"/>
            </properties>
          </component>
          <scrollpane id="ca8dc" binding="scrollPanel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none" title=""/>
            <children>
              <component id="936d2" class="javax.swing.JTable" binding="leaderboardTable">
                <constraints/>
                <properties>
                  <autoCreateRowSorter value="true"/>
                  <fillsViewportHeight value="false"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <component id="c8498" class="javax.swing.JLabel" binding="difficultyLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="344" height="48"/>
              </grid>
            </constraints>
            <properties>
              <font size="18"/>
              <text value="难度：EASY"/>
            </properties>
          </component>
          <component id="f3b9" class="javax.swing.JLabel" binding="HIT" custom-create="true">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <hspacer id="9223a">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <grid id="e4561" binding="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="4038b" class="javax.swing.JButton" binding="deleteButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="删除选中记录"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
