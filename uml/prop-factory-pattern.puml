@startuml
'https://plantuml.com/class-diagram

title 道具的工厂模式 UML 类图

abstract class EnemyAircraft {
    + EnemyAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
    + forward():void
    + shoot():List<BaseBullet>
    + {abstract} getScore:int
    + {abstract} getProps:List<AbstractProp>
}

class EliteEnemy {
    - shootNum:int
    - power:int
    - direction:int
    - score:int
    + EliteEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
    + shoot():List<BaseBullet>
    + getScore:int
    + getProps:List<AbstractProp>
}

class MobEnemy {
    - score:int
    + MobEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
    + getScore:int
    + getProps:List<AbstractProp>
}

abstract class AbstractProp {
    + AbstractProp(int locationX, int locationY, int speedX, int speedY)
    + forward():void
    + {abstract} activate(HeroAircraft hero)
}

class HpSupply {
    - hpIncrease:int = 30
    + HpSupply(int x, int y, int speedY)
    + activate(HeroAircraft hero):void
}

class BombSupply {
    + BombSupply(int x, int y, int speedY)
    + activate(HeroAircraft hero):void
}

class FireSupply {
    + FireSupply(int x, int y, int speedY)
    + activate(HeroAircraft hero):void
}

interface PropFactory {
    + {abstract} createProp(int locationX, int locationY): AbstractProp
}

class HpSupplyFactory {
    + speedY
    + createProp(int locationX, int locationY): AbstractProp
}
class BombSupplyFactory {
    + speedY
    + createProp(int locationX, int locationY): AbstractProp
}
class FireSupplyFactory {
    + speedY
    + createProp(int locationX, int locationY): AbstractProp
}

AbstractProp <|-- HpSupply
AbstractProp <|-- BombSupply
AbstractProp <|-- FireSupply

PropFactory <|.. HpSupplyFactory
PropFactory <|.. BombSupplyFactory
PropFactory <|.. FireSupplyFactory

PropFactory ..> AbstractProp

HpSupplyFactory ..> HpSupply
BombSupplyFactory ..> BombSupply
FireSupplyFactory ..> FireSupply

EnemyAircraft ..> AbstractProp
MobEnemy ..> AbstractProp
EliteEnemy ..> AbstractProp
EliteEnemy ..> PropFactory

@enduml